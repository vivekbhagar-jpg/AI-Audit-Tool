# NxtWave AI Audit Platform - Server Environment Configuration
# Copy to .env for local overrides (never commit secrets to version control)

# ==============================================================================
# 1. CORE SERVER CONFIGURATION
# ==============================================================================
PORT=3000
NODE_ENV="development"
SESSION_SECRET="replace-with-a-random-32-byte-hex-string-for-session-encryption"

# ==============================================================================
# 2. INITIAL ADMINISTRATOR BOOTSTRAP
# ==============================================================================
INITIAL_ADMIN_EMAIL="vivekbhagar@gmail.com"
# Optional: Set this to automatically configure the initial admin password on startup
# If not set, bootstrap via the setup screen in the UI or CLI provision script
# INITIAL_ADMIN_PASSWORD="StrongEnterprisePassword123!"

# ==============================================================================
# 3. AI EVALUATION & TRANSCRIPTION (GEMINI API)
# ==============================================================================
# Required for speech transcription ('gemini-3.5-transcribe') and 8-factor rubric evaluation ('gemini-3.8-flash').
# Automatically provided in AI Studio runtime via Secrets panel.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ==============================================================================
# 4. GOOGLE DRIVE RECORDINGS INTEGRATION
# ==============================================================================
# Required for accessing private Google Drive audio recordings.
# For public/view-link recordings, the Drive extractor handles metadata and retrieval.
# For private files, configure a Google OAuth access token or Google Service Account.
# GOOGLE_ACCESS_TOKEN="ya29.a0AfH6..."
# GOOGLE_DRIVE_API_KEY="AIzaSy..."
